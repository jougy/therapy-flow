#!/bin/bash
URL="https://pluri.health"
if which brave >/dev/null 2>&1; then
  brave --app="" "" &
elif which google-chrome >/dev/null 2>&1; then
  google-chrome --app="" "" &
elif which chromium >/dev/null 2>&1; then
  chromium --app="" "" &
elif which microsoft-edge >/dev/null 2>&1; then
  microsoft-edge --app="" "" &
else
  xdg-open "" "" &
fi
