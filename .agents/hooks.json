{
  "pluri-bootstrap": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/session-start.mjs",
        "timeout": 5
      }
    ]
  },
  "pluri-guardrails": {
    "PreToolUse": [
      {
        "matcher": "read_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-use.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/post-tool-use.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
